---
/**
 * CaseSectionHeader.astro — section heading pattern used across every
 * major case-study section (RESEARCH, PROBLEM N, SOLUTION N, SUMMARY).
 *
 *   [Tag pill]               ← Tag/on page (light / red / green by tone)
 *   ↕ 16px stack
 *   Headline                 ← h3 32px Inter Tight Medium #252525 (default)
 *
 * `as` lets the caller change the headline element (h2/h3) without changing
 * the visual style. `size` swaps the typography for sub-sections that use a
 * smaller headline (Problems & Solutions use 24px/h4 instead of 32px/h3).
 */
import Tag from '../Tag.astro';

interface Props {
  caption: string;          // e.g. "{RESEARCH}", "{PROBLEM 1}" (braces stripped)
  headline: string;
  as?: 'h2' | 'h3';
  /**
   * 'h3' (default, 32px Medium) — section-level (Research, Summary, ...)
   * 'h4' (24px Medium) — sub-section level used inside Problems / Solutions
   */
  size?: 'h3' | 'h4';
  /**
   * Tag colour tone (redesign — Tag/on page 1120-47903):
   * 'muted' → light grey tag (Research / Overview / Summary)
   * 'error' → red tag ({PROBLEM N})
   * 'success' → green tag ({SOLUTION N})
   */
  captionTone?: 'muted' | 'error' | 'success';
  id?: string;
}

const { caption, headline, as: HeadingTag = 'h2', size = 'h3', captionTone = 'muted', id } = Astro.props;
const headlineClass = size === 'h4' ? 'text-h4-medium' : 'text-h3';

const tagVariant = captionTone === 'error' ? 'red' : captionTone === 'success' ? 'green' : 'light';
// The tag renders without the old {braces}.
const tagLabel = caption.replace(/[{}]/g, '').trim();
---

<header class="case-section-header" id={id}>
  <Tag label={tagLabel} variant={tagVariant} />
  <HeadingTag class:list={['case-section-header__headline', headlineClass]}>{headline}</HeadingTag>
</header>

<style>
  .case-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* tag hugs its content, left-aligned */
    gap: var(--space-stack-lg); /* 16px */
    width: 100%;
  }

  .case-section-header__headline {
    margin: 0;
    color: var(--color-text-black);
  }
</style>
