---
import { Image } from 'astro:assets';
import buildingImg from '../assets/behind-the-screen/building.png';
import riverImg    from '../assets/behind-the-screen/river.png';
import fontanImg   from '../assets/behind-the-screen/fontan.png';
import playerImg   from '../assets/behind-the-screen/player-image.png';
import playerBg    from '../assets/behind-the-screen/music-player-bg.png';
import folderIcon  from '../assets/behind-the-screen/folder.svg';

/**
 * Behind the Screen — Figma node 1125-49034 (dark redesign rebuild).
 *
 * Light-grey section, heading + a 3-column row (Cards frame 1312×580, gap 20):
 *   1. Bio          — white card, dot-pattern bg, Fira Code bio text.
 *   2. Travelling   — photo fan-out card + music player (built next).
 *   3. Files        — levitating decorative folders (built next).
 *
 * Books and "That's it" cards from the old design are dropped (brief §6.5).
 *
 * Bio text is unchanged except the last line ("→ on the road" → "→ exploring
 * new places"). Paragraphs are 12px apart (Figma paragraphSpacing).
 */

const bioParagraphs = [
  "Hello! I'm Marianna. Besides being a designer, I consider myself an explorer because curiosity is one of the traits that have paved the way to who I am today.",
  "When I'm not working, you can find me:",
  '→ reading an interesting book about psychology',
  '→ watching long podcasts and interviews',
  '→ taking new courses',
  '→ listening to music',
  '→ scrolling on Pinterest',
  '→ exploring new places',
];

/* Decorative floating folders (Figma positions as % of the 424×580 Files card). */
const folders = [
  { label: 'Final_111', x: '17.2%', y: '15.3%' },
  { label: 'Final_222', x: '65.6%', y: '37.1%' },
  { label: 'Final_123', x: '23.1%', y: '67.9%' },
];
---

<section class="behind" id="about" aria-labelledby="behind-heading">
  <div class="behind__inner">
    <h2 id="behind-heading" class="behind__heading text-h2">Behind the Screen</h2>

    <div class="behind__grid">

      <!-- ── Card 1: Bio ─────────────────────────────────── -->
      <article class="behind__card behind__bio dot-pattern">
        <div class="behind__bio-text text-body-mono-lg">
          {bioParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </article>

      <!-- ── Card 2: Travelling + Music player ────────────── -->
      <div class="behind__col-mid">

        <!-- Travelling card: heading + Romania tag + fanned photos -->
        <article class="behind__card behind__travel">
          <div class="behind__travel-head">
            <div class="behind__travel-info">
              <p class="behind__travel-label text-caption-regular">Traveling</p>
              <p class="behind__travel-year">2025</p>
            </div>
            <span class="behind__travel-tag text-caption-regular">Romania</span>
          </div>

          {/* Deck of travel photos on 3 fan slots (front / back-left /
              back-right). slot-* classes set statically so the fan renders with
              no JS; after the fan-out reveal settles JS lets the user swipe /
              drag to rotate the photos through the slots. Decorative → aria-hidden. */}
          <div class="behind__photos" data-fan-photos aria-hidden="true">
            <div class="behind__photo behind__photo--river slot-bl">
              <Image src={riverImg} alt="" width={296} height={368} quality={95} draggable={false} />
            </div>
            <div class="behind__photo behind__photo--fontan slot-br">
              <Image src={fontanImg} alt="" width={296} height={368} quality={95} draggable={false} />
            </div>
            <div class="behind__photo behind__photo--building slot-front">
              <Image src={buildingImg} alt="" width={404} height={466} quality={95} draggable={false} />
            </div>
          </div>
        </article>

        <!-- Music player: frosted album bg, track info, slider, controls -->
        <div class="behind__player">
          <div class="behind__player-body">
            <div class="behind__player-top">
              <div class="behind__player-track">
                <Image src={playerImg} alt="" aria-hidden="true" width={96} height={96} class="behind__player-art" />
                <div class="behind__player-meta">
                  <p class="behind__player-title">Yellow</p>
                  <p class="behind__player-artist text-caption-regular">Coldplay</p>
                </div>
              </div>
              <div class="behind__slider" role="presentation">
                <div class="behind__slider-track"></div>
                <div class="behind__slider-fill"></div>
                <div class="behind__slider-thumb"></div>
              </div>
            </div>
            <div class="behind__controls">
              <span class="behind__ctrl" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16"><path d="M0.959655 7.17076L6.86184 3.63951C7.00786 3.55067 7.17505 3.50267 7.34596 3.50052C7.51686 3.49838 7.68521 3.54217 7.83341 3.62733C7.99421 3.72096 8.12736 3.85549 8.21935 4.01724C8.31134 4.17898 8.35888 4.3622 8.35716 4.54826V7.01858L14.0047 3.63858C14.1507 3.54973 14.3179 3.50173 14.4888 3.49959C14.6597 3.49744 14.828 3.54124 14.9762 3.62639C15.137 3.72003 15.2702 3.85455 15.3622 4.0163C15.4542 4.17805 15.5017 4.36126 15.5 4.54733V11.4536C15.5018 11.6397 15.4543 11.823 15.3623 11.9848C15.2703 12.1466 15.1371 12.2812 14.9762 12.3748C14.828 12.46 14.6597 12.5038 14.4888 12.5016C14.3179 12.4995 14.1507 12.4515 14.0047 12.3626L8.35716 8.98108V11.4523C8.35919 11.6387 8.31179 11.8222 8.21979 11.9843C8.12778 12.1463 7.99446 12.2811 7.83341 12.3748C7.68521 12.46 7.51686 12.5038 7.34596 12.5016C7.17505 12.4995 7.00786 12.4515 6.86184 12.3626L0.959655 8.83139C0.819344 8.74349 0.703665 8.62139 0.623477 8.47654C0.543289 8.33168 0.501221 8.16883 0.501221 8.00326C0.501221 7.8377 0.543289 7.67484 0.623477 7.52999C0.703665 7.38514 0.819344 7.26303 0.959655 7.17514V7.17076Z"/></svg>
              </span>
              <span class="behind__ctrl behind__ctrl--pause" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24"><path d="M9.25 4.5C9.94 4.5 10.5 5.06 10.5 5.75V18.25C10.5 18.94 9.94 19.5 9.25 19.5H6.75C6.06 19.5 5.5 18.94 5.5 18.25V5.75C5.5 5.06 6.06 4.5 6.75 4.5H9.25ZM17.25 4.5C17.94 4.5 18.5 5.06 18.5 5.75V18.25C18.5 18.94 17.94 19.5 17.25 19.5H14.75C14.06 19.5 13.5 18.94 13.5 18.25V5.75C13.5 5.06 14.06 4.5 14.75 4.5H17.25Z"/></svg>
              </span>
              <span class="behind__ctrl behind__ctrl--next" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16"><path d="M0.959655 7.17076L6.86184 3.63951C7.00786 3.55067 7.17505 3.50267 7.34596 3.50052C7.51686 3.49838 7.68521 3.54217 7.83341 3.62733C7.99421 3.72096 8.12736 3.85549 8.21935 4.01724C8.31134 4.17898 8.35888 4.3622 8.35716 4.54826V7.01858L14.0047 3.63858C14.1507 3.54973 14.3179 3.50173 14.4888 3.49959C14.6597 3.49744 14.828 3.54124 14.9762 3.62639C15.137 3.72003 15.2702 3.85455 15.3622 4.0163C15.4542 4.17805 15.5017 4.36126 15.5 4.54733V11.4536C15.5018 11.6397 15.4543 11.823 15.3623 11.9848C15.2703 12.1466 15.1371 12.2812 14.9762 12.3748C14.828 12.46 14.6597 12.5038 14.4888 12.5016C14.3179 12.4995 14.1507 12.4515 14.0047 12.3626L8.35716 8.98108V11.4523C8.35919 11.6387 8.31179 11.8222 8.21979 11.9843C8.12778 12.1463 7.99446 12.2811 7.83341 12.3748C7.68521 12.46 7.51686 12.5038 7.34596 12.5016C7.17505 12.4995 7.00786 12.4515 6.86184 12.3626L0.959655 8.83139C0.819344 8.74349 0.703665 8.62139 0.623477 8.47654C0.543289 8.33168 0.501221 8.16883 0.501221 8.00326C0.501221 7.8377 0.543289 7.67484 0.623477 7.52999C0.703665 7.38514 0.819344 7.26303 0.959655 7.17514V7.17076Z"/></svg>
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- ── Card 3: Files — checkerboard + decorative folders ── -->
      <div class="behind__card behind__files" aria-hidden="true">
        {folders.map((f, i) => (
          <div class:list={['behind__folder', `behind__folder--${i + 1}`]} style={`left:${f.x}; top:${f.y};`}>
            <img src={folderIcon.src} alt="" width="100" height="85" class="behind__folder-icon" />
            <span class="behind__folder-label text-caption-mono">{f.label}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style define:vars={{ playerBgUrl: `url(${playerBg.src})` }}>
  /* ====== Section shell ====== */
  .behind {
    background-color: var(--color-bg-light-grey);
    padding-block: var(--space-section-block);      /* 64 / 44 */
    padding-inline: var(--container-padding-desktop);
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .behind { padding-inline: var(--container-padding-tablet); }
  }
  @media (max-width: 767px) {
    .behind { padding-inline: var(--container-padding-mobile); }
  }

  .behind__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-5xl);                    /* 48 / 32 */
    max-width: 1312px;
    margin-inline: auto;
    width: 100%;
  }

  .behind__heading {
    color: var(--color-text-black);
    margin: 0;
  }

  /* ====== 3-column row (Figma Cards frame) ====== */
  .behind__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: 580px;
    gap: var(--space-stack-xl);                      /* 20px */
    width: 100%;
  }

  /* Middle column stacks the photo card + player (gap 20). */
  .behind__col-mid {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xl);                      /* 20px */
    min-width: 0;
  }

  /* ====== Card base ====== */
  .behind__card {
    position: relative;
    border-radius: var(--radius-2xl);                /* 20 / 16 */
    background-color: var(--color-bg-white);
  }

  /* ====== Card 1: Bio ====== */
  .behind__bio {
    overflow: hidden;                                /* clip the dot pattern to the radius */
    /* Dot-pattern utility, tuned per-surface to the Figma "pattern on white"
       tile (node 1051:40494): Ø4 dot in near-white #F4F4F3, 16px step —
       denser and lighter than the default (dark-hero) dot pattern. */
    --dot-pattern-bg: var(--color-bg-white);
    --dot-pattern-color: #f4f4f3;
    --dot-pattern-step: 16px;
  }
  .behind__bio-text {
    /* Figma text inset: 32px top, 40px sides (node 1125-49034 / "About me"). */
    padding: var(--space-inline-3xl) var(--space-inline-4xl); /* 32 / 40 (→ 24/32 mobile) */
    color: var(--color-text-grey-muted);             /* #737373 */
    display: flex;
    flex-direction: column;
    gap: 12px;                                        /* Figma paragraphSpacing */
  }
  .behind__bio-text p { margin: 0; }

  /* ====== Card 2a: Travelling ====== */
  .behind__travel {
    flex: 0 0 385px;                                 /* Figma travel card height */
    padding: var(--space-inset-2xl);                 /* 24 */
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-3xl);                     /* 32 (container gap) */
    overflow: hidden;
  }
  .behind__travel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-inline-lg);
  }
  .behind__travel-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);                      /* 12 */
  }
  .behind__travel-label { color: var(--color-text-grey-muted); margin: 0; }
  .behind__travel-year {
    margin: 0;
    font-family: var(--font-family-body);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-h2);                  /* 40 / 28 */
    line-height: var(--line-height-tight);
    color: var(--color-text-black);
  }
  /* Romania — Tag/card: #F2F2F2 pill, r8, pad 8/16, mixed-case (NOT uppercased). */
  .behind__travel-tag {
    align-self: flex-start;
    padding: var(--space-inset-sm) var(--space-inset-lg); /* 8 / 16 */
    background-color: var(--color-bg-light-grey);
    border-radius: var(--radius-m);                  /* 8 */
    color: var(--color-text-grey-muted);
    white-space: nowrap;
  }

  /* Deck of travel photos on 3 fan slots. A slot fixes HEIGHT + centre-x + tilt
     + z; each photo keeps its own aspect ratio (baked white frame never crops),
     so a photo is never stretched or cropped whatever slot it lands in. The
     three photos rotate through the slots on swipe/drag (ported from the
     production deck; animations.md §7.1). */
  .behind__photos {
    position: relative;
    height: 232px;                                   /* Figma "images" area */
    flex-shrink: 0;
  }
  /* Enabled by JS after the fan-out reveal settles. pan-y lets a vertical drag
     scroll the page while horizontal drags are captured for the shuffle. */
  .behind__photos.is-draggable { touch-action: pan-y; }
  @media (hover: hover) and (pointer: fine) {
    .behind__photos.is-draggable { cursor: grab; }
    .behind__photos.is-dragging  { cursor: grabbing; }
  }

  /* Photo box — the white frame is baked into the PNG (no CSS border). Rounded +
     overflow so the layered shadow follows the rounded silhouette. Only transform
     is in the base transition: the reveal animates transform, the shuffle sets a
     snappier multi-prop transition inline (see JS advance()). */
  .behind__photo {
    position: absolute;
    border-radius: var(--radius-l);                  /* 12 */
    overflow: hidden;
    will-change: transform;
    transition: transform var(--duration-fan-out-card, 600ms) var(--ease-out);
    user-select: none;
    -webkit-user-select: none;
    box-shadow:
      -8px 132px 37px 0 rgba(102, 102, 102, 0),
      -5px 84px 34px 0 rgba(102, 102, 102, 0.01),
      -3px 47px 28px 0 rgba(102, 102, 102, 0.05),
      -1px 21px 21px 0 rgba(102, 102, 102, 0.09);
  }
  .behind__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;                            /* container owns the drag */
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Each photo keeps its own aspect ratio; slots fix HEIGHT only, width follows. */
  .behind__photo--building { aspect-ratio: 404 / 466; }
  .behind__photo--river,
  .behind__photo--fontan   { aspect-ratio: 296 / 368; }

  /* Fan slots (centre-x via left:% + translateX(-50%); top in px). Figma
     rotation is CCW-positive, CSS rotate() CW-positive → CSS angle = −Figma. */
  .slot-front {                                      /* centre, upright, tallest, top */
    height: 233px;
    left: 50%; top: -1px;
    border-radius: var(--radius-xl);                 /* 14 */
    transform: translateX(-50%) rotate(0deg);
    z-index: 3;
  }
  .slot-bl {                                         /* back-left, tilted */
    height: 184px;
    left: 32.7%; top: 19px;
    transform: translateX(-50%) rotate(-30deg);
    z-index: 1;
  }
  .slot-br {                                         /* back-right, tilted */
    height: 184px;
    left: 67%; top: 19px;
    transform: translateX(-50%) rotate(30deg);
    z-index: 2;
    transition-delay: 120ms;                         /* reveal stagger (fontan +120ms) */
  }

  /* Fan-out reveal — initial (stacked) state: JS sets data-fan-state="initial",
     snapping the side photos onto building's centre with no rotation and no
     transition; removing it fans them out. Offsets = each photo's centre → the
     building centre in the 376×232 frame (±65, +5). */
  .behind__photos[data-fan-state="initial"] .slot-bl {
    transform: translateX(-50%) translate(65px, 5px) rotate(0deg);
    transition: none;
  }
  .behind__photos[data-fan-state="initial"] .slot-br {
    transform: translateX(-50%) translate(-65px, 5px) rotate(0deg);
    transition: none;
  }

  /* ====== Card 2b: Music player ====== */
  .behind__player {
    flex: 0 0 175px;                                 /* Figma player height */
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-2xl);                /* 20 / 16 */
    isolation: isolate;
  }
  /* Frosted album-art wash: the source image blown up + heavily blurred,
     then veiled with 60% white (Figma "blur": white @60% + background blur). */
  .behind__player::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--playerBgUrl);
    background-size: cover;
    background-position: center;
    filter: blur(36px);
    transform: scale(1.4);
    z-index: 0;
  }
  .behind__player::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-overlay-white-60); /* #FFFFFF @ 60% */
    z-index: 1;
  }
  .behind__player-body {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: var(--space-inset-2xl);                 /* 24 */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* Minimum gap between the slider and the controls — space-between still
       spreads them on the tall desktop card, but this keeps ≥8px when the
       mobile card collapses to content height. */
    gap: var(--space-inset-sm);                       /* 8 */
  }
  .behind__player-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-inset-sm);                      /* 8 */
  }
  .behind__player-track {
    display: flex;
    align-items: center;
    gap: var(--space-inline-md);                     /* 12 */
  }
  .behind__player-art {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    flex-shrink: 0;
    /* Slow rotation (brief §8.3). */
    animation: behind-spin 14s linear infinite;
  }
  @keyframes behind-spin { to { transform: rotate(360deg); } }

  .behind__player-meta { display: flex; flex-direction: column; min-width: 0; }
  .behind__player-title {
    margin: 0;
    font-family: var(--font-family-body);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-body-large);          /* 18 / 16 */
    line-height: var(--line-height-tight);
    color: var(--color-text-grey-muted);
  }
  .behind__player-artist { margin: 0; color: var(--color-text-grey-muted); }

  /* Slider */
  .behind__slider { position: relative; height: 17px; }
  .behind__slider-track,
  .behind__slider-fill {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 8px;
    border-radius: var(--radius-pill);
  }
  .behind__slider-track { left: 0; right: 0; background-color: var(--color-bg-light-grey); }
  .behind__slider-fill {
    left: 0;
    width: 79%;                                      /* Figma 298/376 */
    background-image: linear-gradient(90deg, #50869f, #93c9e2); /* Figma slider gradient */
  }
  .behind__slider-thumb {
    position: absolute;
    left: 79%;
    top: 50%;
    width: 17px;
    height: 17px;
    box-sizing: border-box;
    transform: translate(-50%, -50%);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-dark);      /* #397D9C core */
    border: 5px solid var(--color-bg-white);         /* Figma 5px white inside ring */
  }

  /* Controls */
  .behind__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-stack-sm);                      /* 10 ≈ 8; see note */
  }
  .behind__ctrl {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-light-grey);    /* #F2F2F2 */
    border-radius: var(--radius-l);                  /* 12 */
  }
  .behind__ctrl svg { display: block; fill: var(--color-bg-dark-elevated); } /* #1D1D1D */
  .behind__ctrl--next svg { transform: rotate(180deg); }   /* forward = back flipped */

  /* ====== Card 3: Files — checkerboard + folders ====== */
  .behind__files {
    overflow: hidden;
    /* Transparency-grid motif: 27px squares alternating white / #E9E9E9
       (Figma "Files" row rectangles), drawn in CSS instead of ~350 nodes. */
    background-color: var(--color-bg-white);
    background-image:
      linear-gradient(45deg, var(--color-stroke-light) 25%, transparent 25%, transparent 75%, var(--color-stroke-light) 75%),
      linear-gradient(45deg, var(--color-stroke-light) 25%, transparent 25%, transparent 75%, var(--color-stroke-light) 75%);
    background-size: 54px 54px;                       /* 2 × 27px square */
    background-position: 0 0, 27px 27px;
  }

  .behind__folder {
    position: absolute;
    width: 108px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-inset-sm);                       /* 8 (icon → label) */
    pointer-events: none;                             /* decorative only */
    /* Soft levitation (brief §8.3) — the whole folder (icon + label) drifts,
       transform-only per the perf rules. Each folder runs a different duration
       + negative delay so they move out of phase (no synchronized bobbing). */
    animation: behind-levitate 4.6s ease-in-out infinite;
    will-change: transform;
  }
  .behind__folder--2 { animation-duration: 5.4s; animation-delay: -1.6s; }
  .behind__folder--3 { animation-duration: 5s;   animation-delay: -0.8s; }
  @keyframes behind-levitate {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-9px); }
  }
  .behind__folder-icon {
    display: block;
    width: 100px;
    height: 85px;
    filter: drop-shadow(0 10px 16px rgba(37, 37, 37, 0.12));
  }
  /* Label = Caption mono (Fira Code 14/140); .text-caption-mono sets the type. */
  .behind__folder-label {
    color: var(--color-text-black);                   /* #252525 */
    white-space: nowrap;
  }

  /* ====== Mobile (≤767px) — no dedicated frame; adapt per mobile-adaptation.md.
     Cards stack full-width; the photo deck and folder field scale to the
     narrower column. ====== */
  @media (max-width: 767px) {
    .behind__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;                       /* cards size to content */
    }

    /* Cards size to their content when stacked (no fixed 385/580 tiers). */
    .behind__travel,
    .behind__player { flex: 0 0 auto; }

    /* Photo deck scales to ~0.77× so the fan fits the narrow card. */
    .behind__photos { height: 180px; }
    .slot-front { height: 180px; top: 0; }
    .slot-bl,
    .slot-br   { height: 142px; top: 15px; }
    .behind__photos[data-fan-state="initial"] .slot-bl {
      transform: translateX(-50%) translate(50px, 4px) rotate(0deg);
    }
    .behind__photos[data-fan-state="initial"] .slot-br {
      transform: translateX(-50%) translate(-50px, 4px) rotate(0deg);
    }

    /* Files field: checkerboard + floating folders need an explicit height when
       the desktop 580 row is gone. */
    .behind__files {
      min-height: 360px;
      /* Whole cells across the full width (no clipped side column): a conic
         tile is a self-contained 2×2 checker, so sizing it to 100%/6 lays down
         exactly 12 square cells edge-to-edge — no px value to divide unevenly. */
      background-image: conic-gradient(
        var(--color-stroke-light) 90deg,
        var(--color-bg-white) 90deg 180deg,
        var(--color-stroke-light) 180deg 270deg,
        var(--color-bg-white) 270deg
      );
      background-size: calc(100% / 6) calc(100% / 6);
      background-position: 0 0;
    }

    /* Folders scale to 0.75× (whole-pixel). */
    .behind__folder { width: 81px; gap: 6px; }
    .behind__folder-icon { width: 75px; height: 64px; }
  }
</style>

<script>
  // Travelling photo deck — fan-out reveal (once/session) + swipe/drag shuffle,
  // ported from the production site (animations.md §7.1). Folder levitation and
  // the album spin are pure CSS. No reduced-motion special-casing (brief §1.7).
  function initBehindTravel() {
    const container = document.querySelector<HTMLElement>('.behind__photos');
    if (!container || container.dataset.travelInit === '1') return;
    container.dataset.travelInit = '1';

    const river    = container.querySelector<HTMLElement>('.behind__photo--river');
    const fontan   = container.querySelector<HTMLElement>('.behind__photo--fontan');
    const building = container.querySelector<HTMLElement>('.behind__photo--building');
    if (!river || !fontan || !building) return;
    const photos = [river, fontan, building];

    // Ring positions map to slot classes. Rotating ringPos by ±1 cycles the
    // three photos through the fan; order chosen so the front card, when tossed,
    // travels toward the side it was dragged.
    const RING = ['slot-front', 'slot-bl', 'slot-br'];
    const ringPos = new Map<HTMLElement, number>([[building, 0], [river, 1], [fontan, 2]]);
    const applySlots = () => {
      for (const el of photos) {
        el.classList.remove('slot-front', 'slot-bl', 'slot-br');
        el.classList.add(RING[ringPos.get(el)!]);
      }
    };
    const frontEl = () => photos.find((el) => ringPos.get(el) === 0)!;

    const THRESHOLD = 48;   // px of horizontal travel to commit a shuffle
    const SHUFFLE_MS = 450;
    const SHUFFLE_TRANSITION =
      `transform ${SHUFFLE_MS}ms var(--ease-out), left ${SHUFFLE_MS}ms var(--ease-out),` +
      ` top ${SHUFFLE_MS}ms var(--ease-out), height ${SHUFFLE_MS}ms var(--ease-out)`;

    let enabled = false;
    let dragging = false;
    let decided = false;
    let horiz = false;
    let captured = false;
    let pointerId = -1;
    let startX = 0, startY = 0;
    let dragEl: HTMLElement | null = null;

    const snapBack = () => {
      if (!dragEl) return;
      dragEl.style.transition = 'transform 300ms var(--ease-out)';
      dragEl.style.transform = '';
      const el = dragEl;
      window.setTimeout(() => { el.style.transition = ''; }, 320);
    };

    const advance = (dir: number) => {
      for (const el of photos) el.style.transition = SHUFFLE_TRANSITION;
      if (dragEl) dragEl.style.transform = '';   // animate from dragged pos → new slot
      for (const el of photos) ringPos.set(el, (ringPos.get(el)! + dir + 3) % 3);
      applySlots();
      window.setTimeout(() => { for (const el of photos) el.style.transition = ''; }, SHUFFLE_MS + 30);
    };

    const onDown = (e: PointerEvent) => {
      if (!enabled || dragging) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true; decided = false; horiz = false; captured = false;
      pointerId = e.pointerId;
      startX = e.clientX; startY = e.clientY;
      dragEl = frontEl();
      dragEl.style.transition = 'none';
    };

    const onMove = (e: PointerEvent) => {
      if (!dragging || !dragEl) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (!decided) {
        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        decided = true;
        horiz = Math.abs(dx) > Math.abs(dy);
        if (!horiz) { endDrag(e, true); return; }   // vertical → let the page scroll
        container.classList.add('is-dragging');
        try { container.setPointerCapture(e.pointerId); captured = true; } catch {}
      }
      // Front card tracks the pointer with a slight tilt; translateX(-50%) keeps
      // the slot centring while dragging.
      dragEl.style.transform = `translate(calc(-50% + ${dx}px), 0) rotate(${dx * 0.03}deg)`;
    };

    function endDrag(e: PointerEvent, cancel = false) {
      if (!dragging) return;
      dragging = false;
      container.classList.remove('is-dragging');
      if (captured) { try { container.releasePointerCapture(pointerId); } catch {} captured = false; }
      const dx = e.clientX - startX;
      if (!cancel && horiz && Math.abs(dx) > THRESHOLD) {
        advance(dx < 0 ? 1 : -1);                    // drag left → next; right → previous
      } else {
        snapBack();
      }
      dragEl = null;
    }

    container.addEventListener('pointerdown', onDown);
    container.addEventListener('pointermove', onMove);
    container.addEventListener('pointerup', (e) => endDrag(e));
    container.addEventListener('pointercancel', (e) => endDrag(e, true));

    const enableDrag = () => { enabled = true; container.classList.add('is-draggable'); };

    // Fan-out reveal — once per session (window flag survives SPA nav, resets on
    // hard refresh). Then enable the deck once it settles.
    const FANOUT_TOTAL_MS = 720;   // river 0 + 600, fontan 120 + 600
    if (window.__behindFanPlayed) {
      enableDrag();
    } else {
      container.setAttribute('data-fan-state', 'initial');
      const io = new IntersectionObserver((entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          window.__behindFanPlayed = true;
          requestAnimationFrame(() => {
            container.removeAttribute('data-fan-state');
            window.setTimeout(enableDrag, FANOUT_TOTAL_MS);
          });
          obs.unobserve(entry.target);
        }
      }, { threshold: 0.4 });
      io.observe(container);
    }
  }

  document.addEventListener('astro:page-load', initBehindTravel);
</script>
