---
import { Image } from 'astro:assets';
import ArrowSwap from './ArrowSwap.astro';
import CopyEmail from './CopyEmail.astro';
import logoDarkSvg from '../assets/icons/logo-dark.svg';
import chevronDown from '../assets/icons/chevron-down.svg';
import diagonalArrow from '../assets/icons/diagonal-arrow-light.svg';
import arrowLeftBullet from '../assets/icons/arrow-left-light.svg';
import { CONTACT } from '../lib/config.ts';

interface Props {
  variant?: 'home' | 'case';
}

const { variant = 'home' } = Astro.props;

// Nav links: on home page use anchor links (#works), on case pages use /#works
// so a click navigates to home and scrolls to the section.
const navPrefix = variant === 'home' ? '#' : '/#';
---

<header class="header" data-variant={variant}>
  <div class="header__pill">

    {variant === 'home' ? (
      <a href="/" class="header__logo-link" aria-label="Marianna Delihioz — home">
        <Image src={logoDarkSvg} alt="" width={40} height={40} class="header__logo" />
      </a>
    ) : (
      <a href="/" class="header__go-home text-label">
        <ArrowSwap icon={arrowLeftBullet} direction="left" class="header__go-home-icon" />
        <span>Go Home</span>
      </a>
    )}

    {/* Desktop nav — visible on home only, hidden on mobile via CSS */}
    {variant === 'home' && (
      <nav class="header__nav" aria-label="Main">
        <ul class="header__nav-list">
          <li><a href={`${navPrefix}works`}      class="header__nav-link text-label" data-scroll-target="works">Works</a></li>
          <li><a href={`${navPrefix}experience`} class="header__nav-link text-label" data-scroll-target="experience">Experience</a></li>
          <li><a href={`${navPrefix}about`}      class="header__nav-link text-label" data-scroll-target="about">About</a></li>
        </ul>
      </nav>
    )}

    {/* Desktop Contact button + dropdown (hidden on mobile) */}
    <div class="header__contact-wrapper">
      <button
        type="button"
        class="header__contact-button text-label"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="contact-menu"
        data-contact-trigger
      >
        <span>Contact</span>
        <ArrowSwap icon={chevronDown} direction="down" class="header__contact-chevron" />
      </button>

      <ul
        id="contact-menu"
        class="header__contact-menu"
        role="menu"
        aria-label="Contact options"
        data-contact-menu
      >
        <li role="none">
          <CopyEmail label="Email" role="menuitem" />
        </li>
        <li role="none">
          <a
            href={CONTACT.linkedin}
            role="menuitem"
            class="header__contact-menu-link text-label"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>LinkedIn</span>
            <ArrowSwap icon={diagonalArrow} class="header__contact-menu-arrow" />
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </li>
        <li role="none">
          <a
            href={CONTACT.telegram}
            role="menuitem"
            class="header__contact-menu-link text-label"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Telegram</span>
            <ArrowSwap icon={diagonalArrow} class="header__contact-menu-arrow" />
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </li>
      </ul>
    </div>

    {/*
      Mobile Menu button (hidden on desktop). Trigger only — the dropdown
      is rendered as a sibling of the pill (outside this wrapper) so it can
      span the full pill width without inheriting trigger's narrow width.
    */}
    <div class="header__menu-wrapper">
      <button
        type="button"
        class="header__menu-button text-label"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-trigger
      >
        <span>Menu</span>
        <Image src={chevronDown} alt="" width={20} height={20} class="header__menu-chevron" />
      </button>
    </div>

  </div>

  {/*
    Mobile menu dropdown — sibling of pill so positioning is relative to .header
    (which is the sticky positioning context). This avoids the 100vw scrollbar
    discrepancy and lets dropdown align exactly with pill edges.
    Contains nav (Works/Experience/About) + contacts (Email/LinkedIn/Telegram).
  */}
  <ul
    id="mobile-menu"
    class="header__menu-dropdown"
    role="menu"
    aria-label="Site menu — navigation and contacts"
    data-menu-menu
  >
    {/* Nav tabs — full-width buttons with SVG dotted border, stacked vertically */}
    <li role="none"><a href={`${navPrefix}works`}      role="menuitem" class="header__menu-tab text-label" data-scroll-target="works">Works</a></li>
    <li role="none"><a href={`${navPrefix}experience`} role="menuitem" class="header__menu-tab text-label" data-scroll-target="experience">Experience</a></li>
    <li role="none"><a href={`${navPrefix}about`}      role="menuitem" class="header__menu-tab text-label" data-scroll-target="about">About</a></li>

    {/* Section label "CONTACT" (decorative — not a focusable menu item) */}
    <li role="separator" class="header__menu-section-label text-caption-mono">CONTACT</li>

    {/* Contacts group — horizontal row of 3 inline links with diagonal arrows */}
    <li role="none" class="header__menu-contacts">
      <CopyEmail label="Email" role="menuitem" />
      <a
        href={CONTACT.linkedin}
        role="menuitem"
        class="header__menu-contact-link text-label"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>LinkedIn</span>
        <ArrowSwap icon={diagonalArrow} class="header__menu-contact-arrow" />
        <span class="sr-only">(opens in new tab)</span>
      </a>
      <a
        href={CONTACT.telegram}
        role="menuitem"
        class="header__menu-contact-link text-label"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Telegram</span>
        <ArrowSwap icon={diagonalArrow} class="header__menu-contact-arrow" />
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </li>
  </ul>
</header>

<style>
  /* ====== Sticky outer wrapper ====== */
  .header {
    position: sticky;
    top: var(--space-stack-2xl); /* 24px from top per interactions.md 2.1 */
    z-index: var(--z-header);
    display: flex;
    justify-content: center;
    pointer-events: none; /* let clicks pass through gaps beside the pill */
    padding-inline: var(--container-padding-mobile);
  }

  @media (min-width: 768px) {
    .header {
      padding-inline: var(--container-padding-tablet);
    }
  }

  @media (min-width: 1280px) {
    .header {
      padding-inline: var(--container-padding-desktop);
    }
  }

  /* ====== The centered pill ======
     Redesign (brief §6.7): the header is STATIC — dark pill, no border, no
     shadow, and NO change on scroll. The old Default↔Scrolling state is
     dropped entirely. Figma node 1116:42413 → bg dark elevated, radius-2xl,
     8px inset, 32px gap between logo / tabs / Contact. */
  .header__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-inline-3xl);
    padding: var(--space-inset-sm);
    background-color: var(--color-bg-dark-elevated);
    border-radius: var(--radius-2xl);
  }

  /* Case variant: fixed pill width 492 (Figma 1116:42422) with content
     justified to opposite edges. */
  @media (min-width: 768px) {
    .header[data-variant="case"] .header__pill {
      width: 492px;
      justify-content: space-between;
      gap: 0;
    }
  }

  /* Mobile: pill stretches full-width, Logo↔Menu pushed to edges. */
  @media (max-width: 767px) {
    .header__pill {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* ====== Logo ====== */
  .header__logo-link {
    display: block;
    line-height: 0;
    border-radius: var(--radius-l);
  }

  .header__logo {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-l);
  }

  /* ====== Nav (Home variant, desktop only) ====== */
  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-inline-sm);
  }

  .header__nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-radius: var(--radius-l);
    color: var(--color-text-light-grey-on-dark);
    background-color: var(--color-bg-dark-elevated);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out); /* 150ms */
  }

  /* Hover: the hovered tab's text brightens (light grey → light on dark);
     the others stay put. Pointer-only — no hover on touch. */
  @media (hover: hover) and (pointer: fine) {
    .header__nav-link:hover {
      color: var(--color-text-light-on-dark);
    }
  }

  /* Hide nav on mobile — Menu dropdown carries nav links there */
  @media (max-width: 767px) {
    .header__nav {
      display: none;
    }
  }

  /* ====== Go Home (Case variant) ======
     Figma 1116:42422 → "Link/Footer": h=32, rounded 12, gap 8, light on dark.
     Asymmetric padding (pl=4 pr=2 py=4) per Figma spec. */
  .header__go-home {
    display: flex;
    align-items: center;
    gap: var(--space-inline-sm);
    height: 32px;
    padding: var(--space-inset-xs) 2px var(--space-inset-xs) var(--space-inset-xs);
    border-radius: var(--radius-l);
    color: var(--color-text-light-grey-on-dark);
  }

  .header__go-home-icon {
    display: block;
    flex-shrink: 0;
  }

  /* ====== Desktop Contact button ======
     Inverted (white) button on the dark pill — Figma "Button/Medium/Primary"
     node 1116:42421: white bg, 1px medium-grey stroke, dark-grey label +
     chevron, h40, rounded 12. */
  .header__contact-wrapper {
    position: relative; /* anchor for the dropdown */
  }

  /* Hide desktop Contact on mobile — replaced by Menu */
  @media (max-width: 767px) {
    .header__contact-wrapper {
      display: none;
    }
  }

  .header__contact-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inset-sm);
    height: 40px;
    padding: var(--space-inset-sm) var(--space-inset-md) var(--space-inset-sm) var(--space-inset-lg);
    background-color: var(--color-bg-white);
    color: var(--color-text-dark-grey);
    border: 1px solid var(--color-stroke-medium-grey);
    border-radius: var(--radius-l);
    cursor: pointer;
    white-space: nowrap;
    /* Colour-only transition on hover (Figma Button/Medium/Primary Mode=Dark:
       bg white→light-grey, text dark-grey→black). Arrow swap unchanged. */
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  /* Hover state — Figma node 1116:43449 (State=Hover, Mode=Dark):
     bg #F2F2F2, text #252525, border unchanged. Pointer-only. */
  @media (hover: hover) and (pointer: fine) {
    .header__contact-button:hover {
      background-color: var(--color-bg-light-grey);
      color: var(--color-text-black);
    }
  }

  /* The chevron is an ArrowSwap (hover = swap-down). The 180° open-rotate
     lives on the WHOLE box; inner icons handle the swap independently.
     The wrapper carries ArrowSwap's own scope, so reach it with :global
     from the (scoped) button.
     Base transition = closing curve (rotate back, 150ms ease-in). */
  .header__contact-button :global(.header__contact-chevron) {
    transition: transform var(--duration-fast) var(--ease-in);
  }

  /* Rotate 180° while the dropdown is open (animations.md §3.3).
     Opening curve = 200ms ease-out. */
  .header__contact-button[aria-expanded="true"] :global(.header__contact-chevron) {
    transform: rotate(180deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* When the dropdown is OPEN the chevron points up — suppress the hover
     swap so it stays still (only the 180° rotate is meaningful there).
     Higher specificity than ArrowSwap's global button:hover rules. */
  .header__contact-button[aria-expanded="true"]:hover :global(.arrow-swap-icon--out),
  .header__contact-button[aria-expanded="true"]:focus-visible :global(.arrow-swap-icon--out) {
    transform: none;
  }
  .header__contact-button[aria-expanded="true"]:hover :global(.arrow-swap-icon--in),
  .header__contact-button[aria-expanded="true"]:focus-visible :global(.arrow-swap-icon--in) {
    transform: var(--swap-in-start, translate(0, -100%));
  }

  /* ====== Desktop Contact dropdown ======
     Dark dropdown (Figma 1116:44055 dark mode): bg dark elevated, 1px
     dark-grey stroke, light-on-dark items. */
  .header__contact-menu {
    position: absolute;
    top: calc(100% + var(--space-stack-sm) + var(--space-stack-sm));
    left: 50%;
    z-index: var(--z-dropdown);
    width: 125px;
    padding: var(--space-inset-md);
    background-color: var(--color-bg-dark-elevated);
    border: 1px solid var(--color-stroke-dark-grey);
    border-radius: var(--radius-l);
    /* Closed/closing base state (animations.md §3.2): faded + slid up 8px.
       translateX(-50%) keeps it centred on the trigger. visibility:hidden
       removes it from the a11y tree + tab order when closed; the delayed
       visibility transition keeps it visible through the 150ms fade-out.
       Base transition = the CLOSING curve (150ms ease-in). */
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-8px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-in),
      transform var(--duration-fast) var(--ease-in),
      visibility 0s linear var(--duration-fast);
  }

  /* Open state (animations.md §3.1): faded in + slid into place.
     Overrides the transition with the OPENING curve (200ms ease-out);
     visibility flips to visible immediately (no delay). */
  .header__contact-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility 0s;
  }

  .header__contact-menu-link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-inset-sm);
    height: 32px;
    padding: var(--space-inset-xs) 2px var(--space-inset-xs) var(--space-inset-xs);
    border-radius: var(--radius-l);
    color: var(--color-text-light-grey-on-dark);
  }

  .header__contact-menu-arrow {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* ====== Mobile Menu button (hidden on desktop) ======
     Inverted (white) — same treatment as Contact (Figma mobile 647:23550). */
  .header__menu-wrapper {
    position: relative;
    display: none; /* hidden on desktop */
  }

  @media (max-width: 767px) {
    .header__menu-wrapper {
      display: block;
    }
  }

  .header__menu-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inset-sm);
    height: 40px;
    padding: var(--space-inset-sm) var(--space-inset-md) var(--space-inset-sm) var(--space-inset-lg);
    background-color: var(--color-bg-white);
    color: var(--color-text-dark-grey);
    border: 1px solid var(--color-stroke-medium-grey);
    border-radius: var(--radius-l);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  /* Menu button hover — same as Contact (Figma Mode=Dark hover). */
  @media (hover: hover) and (pointer: fine) {
    .header__menu-button:hover {
      background-color: var(--color-bg-light-grey);
      color: var(--color-text-black);
    }
  }

  .header__menu-chevron {
    display: block;
    width: 20px;
    height: 20px;
    /* Base transition = closing curve (150ms ease-in). */
    transition: transform var(--duration-fast) var(--ease-in);
  }

  /* Rotate chevron when menu is open (a11y hint + animations.md §3.3).
     Opening curve = 200ms ease-out. */
  .header__menu-button[aria-expanded="true"] .header__menu-chevron {
    transform: rotate(180deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* ====== Mobile Menu dropdown ======
     Sibling of pill inside .header (sticky positioning context).
     Dark surface (Figma mobile 647:23550): bg dark elevated, 1px dark-grey
     stroke, 12px radius. Position absolute relative to .header padding-box so
     left/right anchors match the header's padding-inline. */
  .header__menu-dropdown {
    position: absolute;
    top: calc(100% + var(--space-stack-sm) + var(--space-stack-sm)); /* 16px below pill */
    /* Anchor to header's padding-box edges + offset by padding-inline to land
       exactly on the pill's outer edges (pill is inside header content area) */
    left: var(--container-padding-mobile);
    right: var(--container-padding-mobile);
    z-index: var(--z-dropdown);
    pointer-events: auto;
    padding: var(--space-inset-lg); /* 16px per Figma */
    background-color: var(--color-bg-dark-elevated);
    border: 1px solid var(--color-stroke-dark-grey);
    border-radius: var(--radius-xl); /* 12px mobile */
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--space-stack-sm); /* 8px between tabs */
    list-style: none;
    margin: 0;
    /* Closed/closing base state (animations.md §3.2): faded + slid up 8px.
       visibility:hidden removes it from a11y tree + tab order when closed;
       delayed visibility transition keeps it through the 150ms fade-out.
       Base transition = closing curve (150ms ease-in). */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-in),
      transform var(--duration-fast) var(--ease-in),
      visibility 0s linear var(--duration-fast);
  }

  /* Open state (animations.md §3.1): faded in + slid into place.
     Opening curve = 200ms ease-out; visibility flips immediately. */
  .header__menu-dropdown.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility 0s;
  }

  /* ====== Nav tab — inline SVG dotted border, full-width, centered text ======
     Same technique as before (CLAUDE.md decision #16): rounded-rect 12px,
     stroke dasharray="0.1 4" round-cap, preserveAspectRatio="none" +
     vector-effect="non-scaling-stroke" so it stretches to any width with a
     uniform dot pattern. Redesign: stroke recoloured to grey-on-dark (#737373)
     for the dark surface. stroke-width bumped to 1.5 (Figma's nominal 1px):
     the data-URI is rasterised as a background, which softens a 1px round dot
     to a faint blur — 1.5 renders the dots as crisp/visible as the Figma tab. */
  .header__menu-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: var(--space-inset-md);
    border: none;
    border-radius: var(--radius-xl); /* 12px mobile */
    background-color: var(--color-bg-dark-elevated);
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 312 41' preserveAspectRatio='none' fill='none'%3E%3Cpath d='M0.5 12.5C0.5 5.87258 5.87258 0.5 12.5 0.5H299.5C306.127 0.5 311.5 5.87258 311.5 12.5V28.5C311.5 35.1274 306.127 40.5 299.5 40.5H12.5C5.87258 40.5 0.5 35.1274 0.5 28.5V12.5Z' stroke='%23737373' stroke-width='1.5' stroke-linecap='round' stroke-dasharray='0.1 4' vector-effect='non-scaling-stroke'/%3E%3C/svg%3E");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    color: var(--color-text-light-grey-on-dark);
    /* Override .text-label mobile size (14/15px) to match Figma tab spec (16px) */
    font-size: var(--font-size-body-large);
    white-space: nowrap;
  }

  /* ====== Section label "CONTACT" (decorative separator) ====== */
  .header__menu-section-label {
    /* Override role="separator" defaults */
    list-style: none;
    text-transform: uppercase;
    color: var(--color-text-grey-muted-on-dark);
    /* 20px from the last tab to CONTACT (Figma 647-22439: container gap 20).
       The grid row-gap already contributes 8px, so add 12px here. Explicit px:
       the stack tokens step down on mobile while this gap is a constant 20. */
    margin-top: 12px;
  }

  /* ====== Contacts row — horizontal flex inside its <li> wrapper ====== */
  .header__menu-contacts {
    display: flex;
    align-items: center;
    gap: var(--space-inline-sm); /* 8px between contact links */
    list-style: none;
    /* 4px from CONTACT to the links row (Figma 647-22439: Contacts inner gap 4).
       The grid row-gap adds 8px, so pull back 4px to land on the 4px target. */
    margin-top: -4px;
  }

  .header__menu-contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inset-sm); /* 8px between text and arrow */
    height: 32px;
    padding: var(--space-inset-xs) 2px var(--space-inset-xs) var(--space-inset-xs);
    border-radius: var(--radius-l);
    color: var(--color-text-light-grey-on-dark);
    white-space: nowrap;
  }

  .header__menu-contact-arrow {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* ====== Link hover (dropdown + mobile menu tabs/contacts) ======
     Figma "Links" component Mode=Dark hover (node 1116:43801): text
     light-grey-on-dark (#BBBBBB) → light-on-dark (#E9E9E9). Colour only —
     the arrow swap animation is unchanged. Pointer-only. */
  .header__contact-menu-link,
  .header__menu-contact-link,
  .header__menu-tab,
  .header__go-home {
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__contact-menu-link:hover,
    .header__menu-contact-link:hover,
    .header__menu-tab:hover,
    .header__go-home:hover {
      color: var(--color-text-light-on-dark);
    }
  }

  /* ====== Accessibility — focus + touch targets ======
     Global :focus-visible (2px solid --color-bg-black at 2px offset) applies.
     Everything here sits on the dark pill, so a black outline is low-contrast
     (dark-on-dark). Use a light outline instead (a11y.md §3.1 contrast) — for
     both the on-dark links AND the white Contact/Menu buttons: their 2px-offset
     outline lands on the dark pill, so it needs to be light to be visible. */
  .header__nav-link:focus-visible,
  .header__go-home:focus-visible,
  .header__contact-menu-link:focus-visible,
  .header__menu-tab:focus-visible,
  .header__menu-contact-link:focus-visible,
  .header__contact-button:focus-visible,
  .header__menu-button:focus-visible {
    outline: 2px solid var(--color-text-light-on-dark);
    outline-offset: 2px;
  }

  /* Minimum 44×44 tap target on touch devices */
  @media (pointer: coarse) {
    .header__contact-menu-link,
    .header__menu-tab,
    .header__menu-contact-link,
    .header__nav-link,
    .header__go-home,
    .header__contact-button,
    .header__menu-button {
      min-height: 44px;
    }
  }
</style>

<script>
  /*
   * Header dropdown behavior — handles BOTH:
   *   1. Desktop Contact dropdown (data-contact-trigger / data-contact-menu)
   *   2. Mobile Menu dropdown (data-menu-trigger / data-menu-menu)
   *
   * Features (a11y per accessibility.md):
   *   - aria-expanded toggled on trigger
   *   - First menu item focused on open
   *   - Trigger refocused on close
   *   - Esc closes + returns focus to trigger
   *   - Outside click closes (no focus return)
   *   - Arrow Up/Down navigates between menu items (wraps)
   *   - Home/End jumps to first/last item
   *
   * Note: the Email item is now a copy-to-clipboard <button> (CopyEmail.astro),
   * so menu-item queries match any [role="menuitem"] (link OR button). Clicking
   * a real link closes the menu; clicking the copy button does NOT (so the
   * "Copied" feedback stays visible) — the close handler targets a[role].
   *
   * Smooth scroll for any [data-scroll-target] link:
   *   - If link's target section exists on current page → smooth scroll + close menu
   *   - Otherwise let browser navigate (e.g. /#works from a case page)
   */

  type DropdownConfig = {
    triggerSelector: string;
    menuSelector: string;
  };

  const initDropdown = ({ triggerSelector, menuSelector }: DropdownConfig) => {
    const trigger = document.querySelector<HTMLButtonElement>(triggerSelector);
    const menu = document.querySelector<HTMLUListElement>(menuSelector);
    if (!trigger || !menu) return;

    // Guard against double-binding (initHeader runs from both the readyState
    // fallback AND astro:page-load).
    if ((trigger as any).__dropdownBound) return;
    (trigger as any).__dropdownBound = true;

    const menuItems = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    const open = () => {
      trigger.setAttribute('aria-expanded', 'true');
      menu.classList.add('is-open');
      // Focus first menu item per a11y.md 2.5
      menuItems()[0]?.focus();
    };

    const close = (returnFocus = true) => {
      trigger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
      if (returnFocus) trigger.focus();
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? close() : open();
    });

    // Outside click closes (no focus return — user clicked elsewhere intentionally)
    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      const target = e.target as Node;
      if (!menu.contains(target) && !trigger.contains(target)) {
        close(false);
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      const items = menuItems();
      const currentIdx = items.indexOf(document.activeElement as HTMLElement);

      switch (e.key) {
        case 'Escape':
          e.preventDefault();
          close();
          break;
        case 'ArrowDown':
          e.preventDefault();
          items[(currentIdx + 1) % items.length]?.focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          items[(currentIdx - 1 + items.length) % items.length]?.focus();
          break;
        case 'Home':
          e.preventDefault();
          items[0]?.focus();
          break;
        case 'End':
          e.preventDefault();
          items[items.length - 1]?.focus();
          break;
      }
    });

    // Clicking a real link menu item closes the menu (link still navigates).
    // The copy-email <button> is intentionally excluded so "Copied" stays up.
    menu.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a[role="menuitem"]')) close(false);
    });
  };

  /*
   * Smooth scroll for [data-scroll-target] links on the SAME page.
   * On case pages, these links point to /#section so the browser navigates
   * to home naturally; smooth scroll only kicks in once on the home page.
   */
  const initSmoothScroll = () => {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-scroll-target]');
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.dataset.scrollTarget;
        if (!targetId) return;
        // Only intercept if the target exists on the current page
        const target = document.getElementById(targetId);
        if (!target) return; // let browser navigate (e.g. /#works from case page)
        e.preventDefault();
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({
          behavior: prefersReduced ? 'auto' : 'smooth',
          block: 'start',
        });
        // Move focus to the section for screen readers
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    });
  };

  const initHeader = () => {
    initDropdown({ triggerSelector: '[data-contact-trigger]', menuSelector: '[data-contact-menu]' });
    initDropdown({ triggerSelector: '[data-menu-trigger]',    menuSelector: '[data-menu-menu]'    });
    initSmoothScroll();
  };

  // Astro View Transitions fires astro:page-load on every page swap; bind there.
  document.addEventListener('astro:page-load', initHeader);
  // Fallback for first paint without view transitions
  if (document.readyState !== 'loading') initHeader();
  else document.addEventListener('DOMContentLoaded', initHeader);
</script>
