---
/**
 * Footer.astro — global dark site footer (redesign brief §6.6, Figma
 * 1126:52940). Identical on home + case pages, so the old light/inverted
 * `variant` prop is gone — it's dark everywhere now.
 *
 * Layout: a 3-column top row (logo | Explore links | "Let's get in touch"
 * email), a full-width dotted divider, then a 3-column info row
 * (Ukraine | live Kyiv time | © All rights reserved). Top + info share the
 * same 3-column grid so the info items sit under their columns.
 *
 * - Explore links: LinkedIn, Telegram, Dribbble, Download CV (2×2 grid).
 * - Email: click-to-copy (CopyEmail.astro, brief §8.4), underlined address.
 * - Kyiv time: Intl.DateTimeFormat Europe/Kyiv 12h, refreshed each minute
 *   client-side (brief §9.2). A build-time value is rendered as the initial
 *   paint so there's no empty flash; the script corrects it on load.
 * - Divider + bird: per Figma the divider is a plain full-width dotted line
 *   and the bird lives inside the logo tile (Logo in footer.svg). No animation.
 */
import { Image } from 'astro:assets';
import ArrowSwap from './ArrowSwap.astro';
import CopyEmail from './CopyEmail.astro';
import logoFooter from '../assets/icons/logo-footer.svg';
import diagonalArrow from '../assets/icons/diagonal-arrow-light.svg';
import { CONTACT, RESUME_URL } from '../lib/config.ts';

// Build-time Kyiv time for the initial paint (client script keeps it live).
const kyivTimeInitial = new Intl.DateTimeFormat('en-US', {
  timeZone: 'Europe/Kyiv',
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
}).format(new Date());

const exploreLinks = [
  { label: 'LinkedIn',    href: CONTACT.linkedin, external: true },
  { label: 'Telegram',    href: CONTACT.telegram, external: true },
  { label: 'Dribbble',    href: CONTACT.dribbble, external: true },
  { label: 'Download CV', href: RESUME_URL,       external: true },
];
---

<footer class="footer" aria-label="Site footer">
  <div class="footer__card">
  <div class="footer__body">

    <div class="footer__top">
      <div class="footer__logo" aria-hidden="true">
        <Image src={logoFooter} alt="" width={60} height={60} class="footer__logo-img" />
      </div>

      <div class="footer__col footer__col--explore">
        <p class="footer__heading text-caption-mono">Explore</p>
        <ul class="footer__links">
          {exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer__link text-label"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{link.label}</span>
                <ArrowSwap icon={diagonalArrow} class="footer__link-arrow" />
                <span class="sr-only">(opens in new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__col footer__col--touch">
        <p class="footer__heading text-caption-mono">Let&#8217;s get in touch</p>
        <CopyEmail label={CONTACT.email} underline />
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__divider" aria-hidden="true"></div>
      <div class="footer__info">
        <span class="footer__info-item footer__info-loc text-caption-mono">Ukraine</span>
        <span
          class="footer__info-item footer__info-time text-caption-mono"
          data-kyiv-time
        >{kyivTimeInitial}</span>
        <span class="footer__info-item footer__info-copy text-caption-mono">© All rights reserved</span>
      </div>
    </div>

  </div>
  </div>
</footer>

<style>
  /* ====== Outer footer shell ======
     Deep-black card with 40px top corners (radius-4xl). Full-bleed with the
     container padding scale; top/bottom padding per Figma (48 / 40). */
  /* Outer wrapper — light-grey (Figma "Footer section" #F2F2F2). It shows
     through the deep-black card's rounded top corners (the corner notches),
     so they read light-grey rather than the page white. */
  .footer {
    background-color: var(--color-bg-light-grey);
  }

  /* Deep-black card with rounded top corners (radius-4xl: 40 desktop / 32
     mobile). Figma 1126-52940: pt 48 / pb 40 desktop (tokens auto-scale to
     32/32 on mobile). px follows the container-padding scale (16/32/64). */
  .footer__card {
    background-color: var(--color-bg-deep-black);
    border-top-left-radius: var(--radius-4xl);
    border-top-right-radius: var(--radius-4xl);
    padding-block: var(--space-stack-5xl) var(--space-stack-4xl);
    padding-inline: var(--container-padding-mobile);
  }

  @media (min-width: 768px) {
    .footer__card {
      padding-inline: var(--container-padding-tablet); /* 32 tablet */
    }
  }

  /* Desktop = 64px inset from 1024px up (mobile-adaptation "desktop" breakpoint
     is 1024, and Figma 1126-52940 desktop shows 64 — so 64 applies across all
     real desktop widths, not only ≥1280). */
  @media (min-width: 1024px) {
    .footer__card {
      padding-inline: var(--container-padding-desktop); /* 64 per Figma */
    }
  }

  /* Inner body — justify-between pushes the divider block to the bottom with
     the designed vertical gap (Figma con height 272 on the 360-tall footer). */
  .footer__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-stack-5xl);
    min-height: 272px;
  }

  @media (max-width: 767px) {
    .footer__body {
      min-height: 0;
      gap: var(--space-stack-5xl); /* mobile 32 — links block ↔ divider */
    }
  }

  /* ====== Top row — 3 columns (logo | Explore | touch) ====== */
  .footer__top {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: var(--space-inline-2xl);
  }

  @media (max-width: 767px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-stack-5xl); /* mobile 32 — logo / Explore / touch stacked */
    }
  }

  /* ====== Logo tile (bird lives inside — Logo in footer.svg) ====== */
  .footer__logo {
    line-height: 0;
  }

  .footer__logo-img {
    display: block;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-xl);
  }

  /* Mobile logo tile 48×48 (Figma Mobile_Footer_New). The tile's rounding is
     baked into the SVG, so it scales down with the box. */
  @media (max-width: 767px) {
    .footer__logo-img {
      width: 48px;
      height: 48px;
    }
  }

  /* ====== Link columns ====== */
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-lg); /* 16px heading → links (Figma con gap 16) */
  }

  .footer__heading {
    color: var(--color-text-grey-muted);
  }

  /* Explore: 2×2 grid of links (LinkedIn Telegram / Dribbble Download CV).
     Column gap 24 (Marianna: use the existing --space-inline-2xl token
     instead of Figma's raw 28). Row gap 12. */
  .footer__links {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    column-gap: var(--space-inline-2xl); /* 24 desktop / 20 mobile */
    row-gap: var(--space-stack-md);      /* 12 desktop / 8 mobile */
    list-style: none;
  }

  @media (max-width: 767px) {
    .footer__links {
      column-gap: var(--space-inline-xl); /* 16 on mobile (Figma Links_footer gap) */
    }
  }

  /* ====== Individual link ====== */
  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inset-sm); /* 8px text → icon */
    height: 32px;
    padding: var(--space-inset-xs) 2px var(--space-inset-xs) var(--space-inset-xs);
    border-radius: var(--radius-l);
    color: var(--color-text-light-grey-on-dark);
    white-space: nowrap;
  }

  .footer__link-arrow {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* Link hover — Figma "Links" Mode=Dark hover (node 1116:43801): text
     light-grey-on-dark → light-on-dark. Arrow swap unchanged. Pointer-only. */
  .footer__link {
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover {
      color: var(--color-text-light-on-dark);
    }
  }

  /* The email copy button is CopyEmail.astro — it carries its own box/focus
     styles (underline via the `underline` prop, "Copied" green flash). */

  /* ====== Divider + info ====== */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xl); /* 20px (Figma 21) divider → info */
  }

  /* Full-width dotted divider (Figma vector: stroke #4A4A4A, dasharray 0.1 8,
     round cap, 2px). Inline SVG stretched with preserveAspectRatio="none" +
     non-scaling-stroke keeps the dots uniform at any width (same technique as
     the header menu tab border). */
  .footer__divider {
    height: 2px;
    width: 100%;
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1314 2' preserveAspectRatio='none' fill='none'%3E%3Cpath d='M1 1H1313' stroke='%234A4A4A' stroke-width='2' stroke-linecap='round' stroke-dasharray='0.1 8' vector-effect='non-scaling-stroke'/%3E%3C/svg%3E");
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  /* Info row — same 3 columns as the top row so items align under their
     column (Ukraine | Kyiv time | © All rights reserved). */
  .footer__info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-inline-2xl);
  }

  .footer__info-item {
    color: var(--color-text-grey-muted-on-dark);
  }

  /* Mobile (Figma Mobile_Footer_New 1176-9742): "Ukraine" and the time share
     one row (space-between), "© All rights reserved" drops to a second row. */
  @media (max-width: 767px) {
    .footer__info {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "loc time"
        "copy copy";
      gap: var(--space-stack-md) var(--space-inline-md);
    }
    .footer__info-loc  { grid-area: loc; }
    .footer__info-time { grid-area: time; justify-self: end; }
    .footer__info-copy { grid-area: copy; }
  }

  /* ====== Focus (dark surface) — light outline for on-dark links ====== */
  .footer__link:focus-visible {
    outline: 2px solid var(--color-text-light-on-dark);
    outline-offset: 2px;
  }

  /* Minimum 44×44 tap target on touch devices */
  @media (pointer: coarse) {
    .footer__link {
      min-height: 44px;
    }
  }
</style>

<script>
  /*
   * Live Kyiv time in the footer (brief §9.2). Formats Europe/Kyiv, 12h, and
   * refreshes on the minute boundary so it stays accurate without a per-second
   * timer. Re-synced on every astro:page-load (View Transitions swap the DOM).
   */
  const formatKyiv = () =>
    new Intl.DateTimeFormat('en-US', {
      timeZone: 'Europe/Kyiv',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    }).format(new Date());

  let kyivTimer: number | undefined;

  const syncKyivTime = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-kyiv-time]');
    if (!els.length) return;
    els.forEach((el) => { el.textContent = formatKyiv(); });
  };

  const scheduleKyivTick = () => {
    window.clearTimeout(kyivTimer);
    const now = new Date();
    // ms until the next minute boundary (+ tiny buffer)
    const msToNextMinute = (60 - now.getSeconds()) * 1000 - now.getMilliseconds() + 50;
    kyivTimer = window.setTimeout(() => {
      syncKyivTime();
      scheduleKyivTick();
    }, msToNextMinute);
  };

  const initKyivTime = () => {
    syncKyivTime();
    scheduleKyivTick();
  };

  document.addEventListener('astro:page-load', initKyivTime);
  if (document.readyState !== 'loading') initKyivTime();
  else document.addEventListener('DOMContentLoaded', initKyivTime);
</script>
